# Puerto de la API
PORT=4000

# Origen permitido para CORS (el front en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Supabase Auth: login del panel admin (los mismos valores que VITE_SUPABASE_* del front)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Emails con acceso al admin, separados por coma (vacío = cualquier usuario de Supabase Auth)
ADMIN_EMAILS=

# Postgres (Supabase → Project Settings → Database → Connect).
# App: transaction pooler (puerto 6543). Migraciones: session pooler (puerto 5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
